# Copy to .env and fill in. NEVER commit .env
NODE_ENV=production
PORT=8070
HOST=127.0.0.1

# 64+ random chars:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_TTL_DAYS=14

# Comma separated origins allowed to call the API (GitHub Pages, your domain, Capacitor)
ALLOWED_ORIGINS=https://localhost,capacitor://localhost,http://localhost:8080,https://ezzittech.github.io
# Set to 1 when running behind nginx so the real client IP is used for rate limiting
TRUST_PROXY=1

# Database file (SQLite, created automatically)
DB_FILE=./data/marifah.db

# Odoo: talk to it locally on the same server (fast, no TLS)
ODOO_URL=http://127.0.0.1:8069
ODOO_DB=Marifahdb
ODOO_USER=
ODOO_PASS=
# Public Odoo URL used in Billplz callback/redirect links
ODOO_PUBLIC_URL=https://portal.marifah.edu.my

# Fedena (phase 2)
FEDENA_URL=https://erp.marifah.edu.my
FEDENA_TOKEN=
