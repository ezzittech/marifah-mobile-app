[Unit]
Description=Marifah API
After=network.target

[Service]
Type=simple
User=marifah
WorkingDirectory=/opt/marifah-mobile-app/backend
ExecStart=/usr/bin/node --env-file=.env src/server.js
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/marifah-mobile-app/backend/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
